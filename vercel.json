{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/about", "destination": "/physicians/", "permanent": true },
    { "source": "/about/", "destination": "/physicians/", "permanent": true },
    { "source": "/pricing", "destination": "/investment/", "permanent": true },
    { "source": "/pricing/", "destination": "/investment/", "permanent": true },
    { "source": "/faq", "destination": "/who-we-help/", "permanent": true },
    { "source": "/faq/", "destination": "/who-we-help/", "permanent": true },
    { "source": "/payment-options", "destination": "/investment/", "permanent": true },
    { "source": "/payment-options/", "destination": "/investment/", "permanent": true },
    { "source": "/helpful-links", "destination": "/resources/", "permanent": true },
    { "source": "/helpful-links/", "destination": "/resources/", "permanent": true }
  ]
}
